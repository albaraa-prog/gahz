{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gahz-4e276.web.app/schema/question-bank.json",
  "title": "Gahz question bank",
  "description": "A question bank file is a JSON array of multiple-choice questions.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/question" },
  "definitions": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "difficulty", "question", "options", "correctAnswer", "explanation"],
      "properties": {
        "id": {
          "description": "Unique across every bank. Use the next free integer.",
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "description": "Topic shown on the question card and in the results breakdown.",
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "difficulty": {
          "enum": ["easy", "medium", "hard"]
        },
        "question": {
          "type": "string",
          "minLength": 10
        },
        "codeSnippet": {
          "description": "Optional code shown in a monospace block under the question.",
          "type": "string",
          "minLength": 1
        },
        "options": {
          "description": "Exactly four answer choices.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "correctAnswer": {
          "description": "Zero-based index into options.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "explanation": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
